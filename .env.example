# Base URL das chamadas REST (interceptadas pelo MSW quando os mocks estão ativos)
VITE_API_URL=/api
# Origem do servidor Socket.IO (sem caminho: o namespace é "/"). Interceptado pelo MSW quando os mocks estão ativos.
VITE_SOCKET_URL=wss://realtime.kurio.local
# Ativa a camada de mocks (MSW). Padrão: true, inclusive no build de demonstração.
VITE_ENABLE_MOCKS=true
